{
  "name": "dsh-last-word",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "description": "The Last Word for DSH: edit the model's reply, keep every tool record, continue from your version. 本对话最终解释权归你所有。",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "message-edit",
    "reply-edit",
    "branch",
    "last-word"
  ],
  "license": "Apache-2.0",
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "scripts": {
    "test": "node navigation.check.mjs"
  },
  "dependencies": {
    "@deepseek-ai/dsh-session": "0.2.2-rc.1"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "core.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "LICENSE",
    "NOTICE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "devDependencies": {
    "@deepseek-ai/dsh-agent": "0.2.2-rc.1",
    "@deepseek-ai/dsh-agent-loop": "0.2.2-rc.1"
  }
}